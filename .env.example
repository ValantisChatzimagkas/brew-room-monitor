# `make setup` copies this to `.env`, the only env file: native dev, `make check-*` and
# `docker compose` all read it. Write values unquoted.
# The sign-in values below point at the local provider that `make dev` / `make up` start. `http://` is
# dev only: with ENVIRONMENT=production both apps refuse it. For an Auth0 tenant, use the commented forms
# instead (README.md, Quick start).

# Read by the backend.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://brew:brew@localhost:5432/brew
# User sign-in. AUTH_ISSUER must equal the token's `iss` exactly (the local one has no trailing slash; Auth0's ends in `/`).
# Unset = `make dev` / `make up` refuse to start (run without make: user routes return 401 and the dashboard fails with
# `AUTH_AUDIENCE must be set`); both are required in production (issuer over https).
# The backend refuses to boot with only one of the pair. AUTH_AUDIENCE is also read by the frontend, so one value feeds both.
AUTH_ISSUER=http://oidc.localhost:9400/default
# AUTH_ISSUER=https://<tenant>.auth0.com/
# The local provider's tokens always carry aud=default; for Auth0 it's the API identifier.
AUTH_AUDIENCE=default

# Read by the frontend server. Compose overrides DATABASE_URL and API_URL with in-network hosts.
API_URL=http://localhost:8000
# Dashboard sign-in (the local provider, or an Auth0 Regular Web Application: see docs/decisions/0001-hosted-oidc-provider-for-user-sign-in.md).
# The frontend also reads AUTH_AUDIENCE and ENVIRONMENT from above.
AUTH0_DOMAIN=http://oidc.localhost:9400/default
# AUTH0_DOMAIN=<tenant>.auth0.com
# The local provider accepts any client; these are not secrets.
AUTH0_CLIENT_ID=brew-local
AUTH0_CLIENT_SECRET=any-value-works-locally
# Session cookie encryption key: `make setup` fills it (or: openssl rand -hex 32).
AUTH0_SECRET=
# Public URL of the frontend, no trailing slash.
# APP_BASE_URL=http://localhost:3000
# `make setup` appends OIDC_JSON_CONFIG: the local provider's config, this clone's signing key and its login form. It is a secret:
# never commit or share it. Without it `make oidc` refuses, because the provider's built-in key is public.

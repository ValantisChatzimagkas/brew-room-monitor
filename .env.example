# Copy to `.env` (docker compose), `backend/.env` and `frontend/.env.local` (native dev).
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me

# backend/.env
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://brew:brew@localhost:5432/brew

# frontend/.env.local
API_URL=http://localhost:8000

# `make setup` copies this to `.env`, the only env file: native dev, `make check-*` and
# `docker compose` all read it. It fills in a generated ADMIN_TOKEN. Write values unquoted.
ADMIN_TOKEN=change-me

# Read by the backend.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://brew:brew@localhost:5432/brew
# User sign-in, backend only. AUTH_ISSUER must equal the token's `iss` exactly (Auth0's ends in `/`).
# Unset = user routes return 401; both are required in production (issuer over https).
# AUTH_ISSUER=https://<tenant>.auth0.com/
# AUTH_AUDIENCE=

# Read by the frontend server. Compose overrides DATABASE_URL and API_URL with in-network hosts.
API_URL=http://localhost:8000

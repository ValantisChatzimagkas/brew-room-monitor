# `make setup` copies this to `.env`, the only env file: native dev, `make check-*` and
# `docker compose` all read it. It fills in a generated ADMIN_TOKEN. Write values unquoted.
ADMIN_TOKEN=change-me

# Read by the backend.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://brew:brew@localhost:5432/brew
# User sign-in. AUTH_ISSUER must equal the token's `iss` exactly (Auth0's ends in `/`).
# Unset = user routes return 401, and so does every dashboard request; both are required in production (issuer over https).
# The backend refuses to boot with only one of the pair. AUTH_AUDIENCE is also read by the frontend, so one value feeds both.
# AUTH_ISSUER=https://<tenant>.auth0.com/
# AUTH_AUDIENCE=

# Read by the frontend server. Compose overrides DATABASE_URL and API_URL with in-network hosts.
API_URL=http://localhost:8000
# Dashboard sign-in (Auth0 Regular Web Application, see docs/decisions/0001-hosted-oidc-provider-for-user-sign-in.md).
# The frontend also reads AUTH_AUDIENCE from above.
# AUTH0_DOMAIN=<tenant>.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# Session cookie encryption key: openssl rand -hex 32
# AUTH0_SECRET=
# Public URL of the frontend, no trailing slash.
# APP_BASE_URL=http://localhost:3000

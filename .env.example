# `make setup` copies this to `.env` (docker compose), `backend/.env` and `frontend/.env.local` (native dev)
# and fills in a generated ADMIN_TOKEN.
ADMIN_TOKEN=change-me

# backend/.env
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://brew:brew@localhost:5432/brew

# frontend/.env.local
API_URL=http://localhost:8000
